#!/bin/bash

# STRATUX_OTA_INSTALL is set by the OTA install mechanism
# (debian/stratux-pre-start.sh) when it runs dpkg -i itself - dpkg invokes
# the previous version's prerm when reinstalling over an interrupted
# ("unpacked"/"half-configured") install record, so this script is in
# scope for the same reentrancy hazard as preinst/postinst. See docs/ota.md.
if [ -n "${STRATUX_OTA_INSTALL:-}" ]; then
	exit 0
fi

echo "Running pre-removal script for the stratux service"
# Raspberry Pi's have the config.txt so this is one way to determine if its a raspberry pi
arch=$(uname -m)
if  [ "$arch" == "aarch64" ]; then
	if [ -f "/boot/firmware/config.txt" ]; then
		systemctl stop stratux_fancontrol
		# stratux_epaper runs on every device, exactly like
		# stratux_fancontrol above (see debian/postinst.dpkg and
		# debian/stratux_epaper.service for why always-running is safe) -
		# it idles with no display attached or the feature disabled, but
		# is still stopped here like any other stratux service.
		# The boot splash first, so it can never still own the panel
		# while the package is being replaced (a no-op once it has
		# exited, which is the normal case).
		systemctl stop stratux_epaper_splash 2>/dev/null || true
		systemctl stop stratux_epaper 2>/dev/null || true
		# The shutdown splash last, so nothing stale is left active once
		# the package is removed. Stopping it runs its ExecStop, which
		# draws nothing here: no power-off is queued, so
		# `epaperd -splash-shutdown` exits 0 without touching the panel.
		systemctl stop stratux_epaper_shutdown 2>/dev/null || true
		# The SSH key restore: only on real removal (not an upgrade, whose postinst
		# re-enables it) undo the enablement so no dangling symlink is left. This
		# never touches /var/lib/stratux-data/ssh/authorized_keys, which is the
		# administrator's persistent data and survives upgrade and removal.
		if [ "${1:-}" = "remove" ]; then
			systemctl disable stratux_ssh_authorized_keys 2>/dev/null || true
		fi
	fi
fi
# Example: Stop the stratux service before removing this version
systemctl stop stratux 2>/dev/null || true
exit 0
