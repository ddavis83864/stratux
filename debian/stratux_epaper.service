[Unit]
Description=Stratux Waveshare e-paper display (optional, disabled by default)
After=stratux.service
Wants=stratux.service

[Service]
ExecStart=/opt/stratux/bin/epaperd
KillMode=process
Restart=always
RestartSec=5
LimitCORE=1073741824

# RAM-backed (tmpfs) runtime status directory for this service's own
# self-reported status file (common.EpaperStatusPath) - created and owned
# by systemd, removed automatically when the unit stops. The Go code also
# creates this directory itself (MkdirAll) so behavior is identical when
# run manually, e.g. during development.
RuntimeDirectory=stratux-epaper
RuntimeDirectoryMode=0755

StandardOutput=null

[Install]
WantedBy=multi-user.target

# This unit IS enabled and started automatically by the package's
# postinst script, exactly like stratux_fancontrol - a manual, post-boot
# `systemctl enable` was found (during hardware validation) to persist
# only in the protected overlay's RAM-backed (tmpfs) upper layer, and to
# be silently lost on the very next reboot (see
# docs/ota-persistent-storage-defect.md), leaving a device that appeared
# configured actually running without the display after any restart.
#
# Running this unit unconditionally is safe on every device, including
# ones with no e-paper display ever attached: epaper_main's own early
# !cfg.Enabled check means it idles - touching no GPIO/SPI at all, making
# only a bounded, cheap localhost HTTP poll every few seconds - whenever
# the durable, owner-controlled `EpaperEnabled` setting is false. Only
# that setting (persisted the same way as every other setting, on
# /boot/firmware, unaffected by the overlay) decides whether this ever
# touches hardware; the systemd unit's own enabled/running state no
# longer needs to track that decision at all.
#
# See docs/waveshare-epaper-display.md's installation procedure: after
# physically wiring the display, the owner enables the feature itself
# through Settings > Epaper Display (or POST /setSettings), never by
# managing this unit directly.
