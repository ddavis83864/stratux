#!/bin/bash
echo "Post install script for stratux is running.."
systemctl daemon-reload

echo "Enabling stratux"
systemctl enable stratux

# STRATUX_OTA_INSTALL is set by the OTA install mechanism
# (debian/stratux-pre-start.sh) when it runs dpkg -i itself. That script
# always reboots once dpkg -i returns (success, retry, or rollback), so
# nothing here needs to be (re)started - and it must not be: this dpkg -i
# is invoked from stratux.service's own ExecStartPre, and systemctl
# start/restart here would recurse into that same unit's ExecStartPre
# while this dpkg -i still holds dpkg's lock, corrupting the install.
# Found on real hardware; see docs/ota.md.
if [ -n "${STRATUX_OTA_INSTALL:-}" ]; then
    exit 0
fi

echo "Enabling udev"
systemctl restart udev

echo "Starting stratux"
systemctl start stratux

# Raspberry Pi's have the config.txt so this is one way to determine if its a raspberry pi
arch=$(uname -m)
if  [ "$arch" == "aarch64" ]; then
    if [ -f "/boot/firmware/config.txt" ]; then
            systemctl enable stratux_fancontrol
            systemctl start stratux_fancontrol

            # stratux_epaper is always enabled/started here, exactly like
            # stratux_fancontrol above - never via a manual, post-boot
            # `systemctl enable`, which would land only in the protected
            # overlay's RAM-backed (tmpfs) upper layer and be lost on the
            # very next reboot (see docs/ota-persistent-storage-defect.md).
            # This is safe on every device, including ones with no e-paper
            # display attached: epaperd idles with zero GPIO/SPI access
            # whenever EpaperEnabled is false in settings (the durable,
            # owner-controlled switch - see epaper_main/main.go's early
            # !cfg.Enabled check) - only settings.EpaperEnabled decides
            # whether it ever touches hardware, never whether the unit runs.
            systemctl enable stratux_epaper
            systemctl start stratux_epaper
    fi
fi
exit 0
