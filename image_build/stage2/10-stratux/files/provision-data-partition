#!/bin/sh
# provision-data-partition: grows the root partition to a bounded cap and
# creates the dedicated persistent-data partition (LABEL=stratux-data) in
# the remaining space - the first-boot-only logic init-overlay calls once,
# factored out into its own script specifically so it can be exercised
# directly, against a real loop-mounted disk image, in
# test/persistent_data_partition_test.sh - without needing to actually
# boot from the image under test. See docs/persistent-data-partition.md
# for the full design and rationale, and docs/ota-persistent-storage-defect.md
# for the incident this closes.
#
# Usage: provision-data-partition <root-device> <root-partition-device>
#   <root-device>: e.g. /dev/mmcblk0 or /dev/sda - the whole disk.
#   <root-partition-device>: e.g. /dev/mmcblk0p2 or /dev/sda2 - the
#     current root partition, already mounted at / (or, under test, not
#     mounted at all - this script itself never assumes / is on this
#     device; only its caller, init-overlay, does the actual `mount -o
#     remount,rw /` and `resize2fs` on the real, live root).
#
# Exit code 0 in every defined outcome (already-non-2-partition layout,
# below-minimum-card-size fallback, or successful provisioning) - callers
# distinguish outcomes from this script's own stdout/log lines, not its
# exit code, matching init-overlay's own existing style of never treating
# a defined, handled case as a shell-level failure.
set -e

ROOT_DEV="$1"
ROOT_PART_DEV="$2"

if [ -z "$ROOT_DEV" ] || [ -z "$ROOT_PART_DEV" ]; then
	echo "usage: provision-data-partition <root-device> <root-partition-device>" >&2
	exit 2
fi

# Minimum supported card size and the bounded root cap - see
# docs/persistent-data-partition.md for the exact rationale. Exported as
# plain shell variables (not read-only) so the test harness can override
# them to exercise both branches against small, fast disposable images
# rather than needing genuinely multi-gigabyte test fixtures.
: "${MIN_CARD_BYTES:=$((16 * 1024 * 1024 * 1024))}"
: "${ROOT_CAP_MIB:=8192}"
# The default assumes this script is running as init-overlay's own
# caller does: as PID 1, before any pivot_root/chroot, when "/" already
# IS the bare root partition being resized - so a bare /etc path is
# correct in production. Overridable so the test harness can point this
# at a loop-mounted partition's own mountpoint instead, since a direct
# (non-chrooted) test invocation of this script does not share that
# same real-root context.
: "${STRATUX_PERSISTENCE_UNSUPPORTED_MARKER:=/etc/stratux-persistence-unsupported}"

settle_udev() {
	# `partprobe` updates the kernel's own partition table synchronously,
	# but the new partition's own device node (/dev/mmcblk0p3 or
	# equivalent) is created by udev in response to the "change" uevent
	# partprobe triggers, and FSTYPE/LABEL lookups can likewise depend
	# on udev's own blkid probe of that node having already run - both
	# asynchronous with respect to partprobe returning. Querying lsblk,
	# or testing for the device node with `[ -b ... ]`, immediately
	# after partprobe with nothing forcing that processing to complete
	# first is a real theoretical race, most likely to actually bite on
	# a slow/loaded first boot. (NOTE: this is not what caused this
	# script's own test suite's Case 6 failure during development - that
	# was a real bug in the test harness's own image fixture reusing
	# stale on-disk bytes from a prior case, fixed separately in
	# test/persistent_data_partition_test.sh's make_test_image - but the
	# race described here is still real and worth closing defensively.)
	# `udevadm settle` blocks until udev's event queue is fully drained,
	# so every lsblk call below is guaranteed to observe udev's view of
	# the partition table as fully caught up with the kernel's own.
	if command -v udevadm >/dev/null 2>&1; then
		udevadm settle --timeout=5 2>/dev/null || true
	else
		# No udevadm available (unlikely on a real Pi image, possible in
		# a minimal test container) - a short fixed delay is a strictly
		# weaker fallback, but better than nothing.
		sleep 1
	fi
}

# lsblk_field_with_retry: reads a single lsblk field (FSTYPE or LABEL)
# for a device, retrying with a short sleep in between if it comes back
# empty. A real hardware-validation finding: at this very early point in
# boot - before udevd itself is even running - lsblk's own filesystem
# detection can race against blkid not yet being able to probe the
# device, even though the filesystem genuinely exists and is correctly
# detected moments later once boot proceeds further (confirmed directly:
# a device this exact check rejected as "not vfat" was independently
# confirmed genuinely vfat via blkid on the same, fully-booted device
# afterward). settle_udev alone does not reliably fix this specific
# race: it waits for udev's own event queue to drain, which is a no-op
# if udevd is not yet running at all to have queued anything - a plain,
# bounded sleep-and-retry is the one thing that helps regardless of
# which of those two causes is actually in play. Never trust a single
# empty read as proof a filesystem is absent - the whole-disk/partition-
# count checks already prove this is genuinely the expected device
# topology; this only bounds how long to wait for blkid's own view of it
# to catch up. Retry count/delay are overridable so the test suite can
# exercise both the retry path and the genuinely-empty case (Case 6's
# own interrupted-before-mkfs partition, which must NOT be mistaken for
# a slow-to-settle one) without paying the full production wait.
: "${FSTYPE_DETECT_RETRIES:=5}"
: "${FSTYPE_DETECT_RETRY_DELAY_SECONDS:=1}"
lsblk_field_with_retry() {
	# $1: device path. $2: lsblk field name (FSTYPE or LABEL).
	local dev="$1" field="$2" value="" tries=0
	while [ "$tries" -lt "$FSTYPE_DETECT_RETRIES" ]; do
		value=$(lsblk -no "$field" "$dev" 2>/dev/null || true)
		[ -n "$value" ] && break
		settle_udev
		sleep "$FSTYPE_DETECT_RETRY_DELAY_SECONDS"
		tries=$((tries + 1))
	done
	printf '%s' "$value"
}

reject_unexpected_layout() {
	# $1: the specific reason, for the log only - every caller reports
	# the same RESULT= so init-overlay's own dispatch (and this script's
	# own test suite) has exactly one string to match, regardless of
	# which specific check failed.
	echo "provision-data-partition: ${1} - leaving the partition table untouched"
	echo "RESULT=skipped-unexpected-layout"
	exit 0
}

# This whole script is meant to run exactly once per genuinely fresh
# image (init-overlay only calls it while /var/grow_root_part exists, and
# removes that marker itself once this returns). As an extra, defensive
# safety net - never trust a single signal for something this
# consequential, and never trust partition *count* alone as sufficient
# proof of the expected stock layout - a review requirement this section
# closes:
#  1. ROOT_DEV must be a whole-disk block device (or a loop device, this
#     script's own test harness's stand-in for one) - never a partition
#     or something else entirely.
#  2. The card must have exactly the 2 partitions (boot + root) the stock
#     image ships. A different count already has its own layout (the
#     operational device's own pre-existing dedicated third partition
#     being the known example) or has already been through this logic
#     once.
#  3. Partition 2 of ROOT_DEV must be ROOT_PART_DEV itself - proof this
#     is genuinely the root partition the caller identified via `findmnt
#     / -no source`, not some mismatched pairing.
#  4. Partition 1 must be a FAT/vfat filesystem - the expected boot
#     partition type; refusing to touch a layout where it is anything
#     else.
# Any mismatch here is treated identically: leave the partition table
# completely untouched. See docs/persistent-data-partition.md's own
# migration policy for why this must never guess.
# Defensive: settle udev before this script's own very first read of
# partition state too, in case whatever invoked us (or an interrupted
# prior run of this same script) just changed the partition table and
# hasn't given udev a chance to catch up yet - see settle_udev's own
# comment above for why this matters.
settle_udev
DEV_TYPE=$(lsblk -dno TYPE "$ROOT_DEV" 2>/dev/null || true)
case "$DEV_TYPE" in
	disk|loop) ;;
	*) reject_unexpected_layout "${ROOT_DEV} is type '${DEV_TYPE:-unknown}', not a whole-disk block device" ;;
esac

PART_COUNT=$(lsblk -lno NAME "$ROOT_DEV" | tail -n +2 | wc -l)
if [ "$PART_COUNT" -eq 3 ]; then
	# Not automatically "someone else's layout" - this is also exactly
	# what a power loss/interruption between creating partition 3
	# (mkpart) and formatting it (mkfs.ext4) leaves behind, and the
	# retry marker (/var/grow_root_part, removed by init-overlay
	# regardless of which RESULT= this script reports) is already
	# consumed by the time this runs again - there is no other future
	# opportunity to complete this safely. Distinguish the two cases by
	# what is actually, verifiably true of partition 3 right now, never
	# by assuming which case this is:
	EXISTING_PART3_NAME="$(lsblk -lno NAME "$ROOT_DEV" | sed -n '4p')"
	EXISTING_PART3_DEV="/dev/${EXISTING_PART3_NAME}"
	EXISTING_PART3_FSTYPE="$(lsblk_field_with_retry "$EXISTING_PART3_DEV" FSTYPE)"
	EXISTING_PART3_LABEL="$(lsblk_field_with_retry "$EXISTING_PART3_DEV" LABEL)"
	if [ -z "$EXISTING_PART3_FSTYPE" ]; then
		# No filesystem at all: this can only be our own interrupted
		# mkpart, never a foreign layout in active use (nothing else
		# creates an unformatted partition and leaves it that way) -
		# safe, and necessary, to complete formatting it now, on this
		# one remaining opportunity.
		echo "provision-data-partition: partition 3 of ${ROOT_DEV} already exists but has no filesystem - resuming an interrupted prior attempt rather than leaving it stranded"
		mkfs.ext4 -F -L stratux-data "$EXISTING_PART3_DEV"
		sync
		echo "RESULT=provisioned DATA_PART_DEV=${EXISTING_PART3_DEV} ROOT_END_MIB=resumed"
		exit 0
	fi
	if [ "$EXISTING_PART3_FSTYPE" = "ext4" ] && [ "$EXISTING_PART3_LABEL" = "stratux-data" ]; then
		# Already fully provisioned by this same logic on a previous
		# run (the marker survived a reboot between mkfs completing and
		# init-overlay removing it, or this script was simply invoked
		# again by mistake) - genuinely nothing to do, and reformatting
		# would destroy whatever has already been written there since.
		echo "provision-data-partition: partition 3 of ${ROOT_DEV} is already a provisioned stratux-data filesystem - nothing to do"
		echo "RESULT=already-provisioned DATA_PART_DEV=${EXISTING_PART3_DEV}"
		exit 0
	fi
	reject_unexpected_layout "${ROOT_DEV} already has a third partition (${EXISTING_PART3_FSTYPE:-unknown} filesystem, label '${EXISTING_PART3_LABEL:-none}') that is neither empty nor a provisioned stratux-data filesystem - this is not this script's own layout"
fi
if [ "$PART_COUNT" -ne 2 ]; then
	reject_unexpected_layout "${ROOT_DEV} has ${PART_COUNT} partitions, not the expected 2 (or 3, handled above)"
fi

EXPECTED_ROOT_NAME="$(basename "$ROOT_PART_DEV")"
ACTUAL_PART2_NAME="$(lsblk -lno NAME "$ROOT_DEV" | sed -n '3p')"
if [ "$EXPECTED_ROOT_NAME" != "$ACTUAL_PART2_NAME" ]; then
	reject_unexpected_layout "partition 2 of ${ROOT_DEV} is '${ACTUAL_PART2_NAME}', not the expected root partition '${EXPECTED_ROOT_NAME}'"
fi

PART1_NAME="$(lsblk -lno NAME "$ROOT_DEV" | sed -n '2p')"
PART1_FSTYPE="$(lsblk_field_with_retry "/dev/${PART1_NAME}" FSTYPE)"
case "$PART1_FSTYPE" in
	vfat|fat32) ;;
	*) reject_unexpected_layout "partition 1 of ${ROOT_DEV} has filesystem type '${PART1_FSTYPE:-unknown}', not the expected vfat boot partition" ;;
esac

CARD_BYTES=$(blockdev --getsize64 "$ROOT_DEV")
if [ "$CARD_BYTES" -lt "$MIN_CARD_BYTES" ]; then
	# Below the minimum supported size: fall back to the previous,
	# simpler behavior (grow root to fill the card) rather than leave a
	# card too small to usefully split at all with a cramped, half-sized
	# root and no meaningful data partition. This must never be mistaken
	# for "this device works exactly as it always did" - a review
	# requirement - so an explicit, always-checkable marker is written
	# directly onto the real (bare, pre-overlay) root filesystem, not
	# under /var/lib/stratux-data (which does not exist as anything but
	# an ordinary directory in this branch, precisely the condition being
	# reported). main/health.go surfaces this file's content directly in
	# Storage's own health Reason, so "why" is never left to be inferred
	# from a generic not-mounted message alone.
	echo "provision-data-partition: card (${CARD_BYTES} bytes) is below the minimum supported size (16 GiB) - growing root to fill the card; no dedicated persistent-data partition will be created"
	echo "card capacity ${CARD_BYTES} bytes is below the 16 GiB minimum required for a dedicated persistent-data partition - OTA and durable recording/calibration/diagnostics persistence are not supported on this card; see docs/persistent-data-partition.md" > "$STRATUX_PERSISTENCE_UNSUPPORTED_MARKER"
	parted -s "$ROOT_DEV" resizepart 2 100%
	# `|| true`: partprobe can legitimately report a nonzero exit here -
	# see the longer explanation above resizepart's own partprobe call
	# below, which applies identically to this fallback branch.
	partprobe "$ROOT_DEV" || true
	settle_udev
	sync
	echo "RESULT=grew-root-only-below-minimum-card-size"
	exit 0
fi

ROOT_START_MIB=$(parted -sm "$ROOT_DEV" unit MiB print | awk -F: '$1==2{gsub("MiB","",$2); print int($2)}')
case "$ROOT_START_MIB" in
	''|*[!0-9]*)
		echo "provision-data-partition: ERROR: could not determine partition 2's start offset from parted output - refusing to guess" >&2
		echo "RESULT=failed-could-not-determine-root-start"
		exit 1
		;;
esac
ROOT_END_MIB=$((ROOT_START_MIB + ROOT_CAP_MIB))

echo "provision-data-partition: growing root partition to its bounded cap (${ROOT_CAP_MIB} MiB, ending at ${ROOT_END_MIB}MiB)"
parted -s "$ROOT_DEV" resizepart 2 "${ROOT_END_MIB}MiB"
# `|| true`: on real hardware (confirmed by a hardware-validation run),
# partition 2 here is the ACTIVE, currently-mounted root partition -
# unlike this script's own loop-device test fixtures, where the "root"
# partition under test is never actually mounted by anything. Asking
# the kernel to re-read the WHOLE partition table (what partprobe does)
# while one of that table's own partitions is in active use is a
# well-known Linux hazard: the kernel can safely apply the *other*
# partition-table changes (the entries this script itself cares about
# - this resized partition 2 boundary, and later, the brand-new
# partition 3) via an incremental update, but partprobe can still
# report a nonzero exit status for being unable to also re-read the
# *active* partition's own entry live - a partial, expected outcome,
# not evidence anything this script needs actually failed. This
# script's own subsequent verification (the `[ -b "$DATA_PART_DEV" ]`
# check below, and provision-data-partition's own test suite's
# blkid/lsblk-based assertions) is the real judge of success, never
# partprobe's own exit code - settle_udev below already handles the
# *timing* half of this (waiting for udev to catch up with whatever the
# kernel did apply), this `|| true` handles the *exit-code* half.
partprobe "$ROOT_DEV" || true
settle_udev
sync

echo "provision-data-partition: creating dedicated persistent-data partition (LABEL=stratux-data)"
parted -s "$ROOT_DEV" mkpart primary ext4 "${ROOT_END_MIB}MiB" 100%
partprobe "$ROOT_DEV" || true # see the long comment on the resizepart partprobe call above - applies identically here
settle_udev
sync
# The new partition is always the 3rd line lsblk reports for this device
# (parent, then partitions 1/2/3 in order) - reading it back this way,
# rather than guessing the "p"-infix-or-not naming convention (mmcblk0p3
# vs sda3), works for either.
DATA_PART_DEV="/dev/$(lsblk -lno NAME "$ROOT_DEV" | sed -n '4p')"
if [ ! -b "$DATA_PART_DEV" ]; then
	echo "provision-data-partition: ERROR: expected data partition device ${DATA_PART_DEV} not found after mkpart - leaving /var/lib/stratux-data unprovisioned" >&2
	echo "RESULT=failed-data-partition-not-found"
	exit 1
fi

mkfs.ext4 -F -L stratux-data "$DATA_PART_DEV"
sync
echo "RESULT=provisioned DATA_PART_DEV=${DATA_PART_DEV} ROOT_END_MIB=${ROOT_END_MIB}"
