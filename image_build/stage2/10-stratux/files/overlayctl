modify_boot_cmdline()
{
    if [ ! -e /boot/firmware/cmdline.txt ] ; then
        umount_boot=yes
        mount /boot/firmware || exit 1
    fi
    if [ ! -e /boot/firmware/cmdline.txt ] ; then
        echo "/boot/firmware/cmdline.txt missing"
        exit 1
    fi
    if [ ! -w /boot/firmware ] ; then
        remount_boot_ro=yes
        mount -o remount,rw /boot/firmware || exit 1
    fi
    if ! grep -q '/sbin/init-overlay' /boot/firmware/cmdline.txt ; then
        cp /boot/firmware/cmdline.txt /boot/firmware/cmdline.bak
    fi
    rm -f /boot/firmware/cmdline.new
    sed -e 's/\( \|^\)\(ro\|rw\)\( \|$\)/ /g' \
        -e 's/\( \|^\)\(init=[^ ]*\)\( \|$\)/ /g' \
        -e 's/^ //' -e 's/ $//' /boot/firmware/cmdline.txt \
        -e 's#^\(.*root=.*\)$#\1'"$1"'#'\
        >/boot/firmware/cmdline.new
    mv /boot/firmware/cmdline.new /boot/firmware/cmdline.txt
    if [ -n "$umount_boot" ] ; then
        umount /boot/firmware
    elif [ -n "$remount_boot_ro" ] ; then
        mount -o remount,ro /boot/firmware
    fi
}

overlay_is_active()
{
    # Was: [ -e /overlay/robase/overlay ]. That checks only whether a
    # directory left behind by a *previous* overlay-active session still
    # exists on the real disk - it does, forever, once created, even after
    # a boot that runs genuinely bare ext4 (init-overlay's own disabled
    # branch never removes it). That produced a real, confirmed false
    # positive: `overlayctl status` reported "overlay is active" on a boot
    # that findmnt / plainly showed was bare ext4 - see
    # docs/ota-persistent-storage-defect.md for the hardware
    # evidence. Query the live mount type instead, exactly like
    # debian/stratux-pre-start.sh's own (already-correct) overlay_is_active
    # does - the two implementations diverging is what let this go
    # unnoticed.
    [ "$(findmnt -n -o FSTYPE /)" = "overlay" ]
}

if [ $# -eq 0 ] ; then
    echo "overlayctl [status|enable|disable|lock|unlock]"
    exit 0
fi

if overlay_is_active ; then
    overlay_active="yes"
    overlay_base="/overlay/robase/"
    # /overlay/robase is a bind mount of the same underlying block device
    # that init-overlay's own pivot_root leaves mounted separately at
    # /overlay/pivot (the relocated old root - see docs/ota.md), which
    # itself starts read-only (the kernel's own "ro" boot parameter).
    #
    # Going TO read-write (unlock, and enable/disable's own internal
    # unlock step) must stay a PLAIN remount: a bind mount created from a
    # read-only source inherits a *locked* read-only flag that only a
    # plain, whole-superblock remount can clear - a "bind,rw" remount
    # cannot escalate it (confirmed directly: it silently no-ops rather
    # than granting write access). This matters most on a device's very
    # first boot, when /overlay/robase has never yet been made writable.
    #
    # Going TO read-only (lock, and enable/disable's own internal re-lock
    # step) must instead use a BIND remount: by the time this runs,
    # /overlay/robase has already been genuinely elevated to read-write by
    # the plain unlock above, so a plain "remount,ro" here targets the
    # whole shared superblock rather than just this one bind-mounted view -
    # and fails "mount point is busy" (EBUSY) on real hardware, because
    # /overlay/pivot still holds a live read reference to that same
    # superblock. A bind remount only sets this one view's own read-only
    # flag, which never conflicts with /overlay/pivot and always succeeds.
    # Confirmed on real hardware; see docs/ssh-host-keys.md for the
    # physical validation that found this.
    overlay_remount_ro_bind="bind,"
else
    overlay_active="no"
    overlay_base="/"
    # Not a bind mount in this branch (overlay disabled entirely) - a
    # plain remount is correct for both directions here.
    overlay_remount_ro_bind=""
fi

overlay_disable_file="$overlay_base""overlay/disable"

case "$1" in
    status)
        echo -n "overlay is "
        if [ "$overlay_active" = "yes" ] ; then
            echo "active"
        else
            echo "inactive"
        fi
        echo -n "overlay "
        if [ -e "$overlay_disable_file" ] ; then
            echo -n "disabled"
        else
            echo -n "enabled"
        fi
        echo " for next boot"
        ;;

    enable)
        if [ -e "$overlay_disable_file" ] ; then
            if [ -w "$overlay_base/overlay" ] ; then
               rm "$overlay_disable_file"
            else
               mount -o remount,rw "$overlay_base"
               rm "$overlay_disable_file"
               mount -o remount,${overlay_remount_ro_bind}ro "$overlay_base"
            fi
        fi
        ;;

    disable)
        if [ ! -e "$overlay_disable_file" ] ; then
            if [ -w "$overlay_base/overlay" ] ; then
               echo 1 >"$overlay_disable_file"
            else
               mount -o remount,rw "$overlay_base"
               echo 1 >"$overlay_disable_file"
               mount -o remount,${overlay_remount_ro_bind}ro "$overlay_base"
            fi
        fi
        ;;

    lock)
        mount -o remount,${overlay_remount_ro_bind}ro "$overlay_base"
        ;;

    unlock)
        mount -o remount,rw "$overlay_base"
        ;;

    install)
        modify_boot_cmdline " ro init=/sbin/init-overlay"
        mkdir -p /overlay
        ;;

    uninstall)
        modify_boot_cmdline " ro"
        ;;

    *)
        echo "overlayctl: unknown option"
        exit 1
        ;;
esac